# Supabase project settings (Project Settings > API Keys in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# 아래 세 값은 /api/clip(공유하기 → 애플 단축어 스크랩) 기능에만 필요.
# 서버 전용이라 NEXT_PUBLIC_ 접두사가 없고, 절대 브라우저로 노출되지 않음.
# secret 키(Project Settings > API Keys의 "secret" 항목, 예전 service_role)
SUPABASE_SECRET_KEY=sb_secret_your-key
# 단축어가 헤더에 담아 보낼, 직접 정한 임의의 긴 문자열
CLIP_API_SECRET=change-me-to-a-long-random-string
# Supabase Authentication > Users에서 본인 계정의 User UID
CLIP_USER_ID=00000000-0000-0000-0000-000000000000
# /api/context(아이폰 집중 모드 단축어 → 회사/개인 컨텍스트 전환)용. CLIP_API_SECRET과 다른 임의의 긴 문자열.
# SUPABASE_SECRET_KEY · CLIP_USER_ID도 같이 필요. README의 "컨텍스트 단축어" 참고.
CONTEXT_API_SECRET=change-me-to-another-long-random-string
# 웹 푸시(할 일 시작 10분 전 알림 · 앱 배지). `npx web-push generate-vapid-keys`로 만든 키 한 쌍.
# 공개키는 브라우저 구독에 쓰여 NEXT_PUBLIC_이 정상, 비공개키는 서버 전용. README의 "푸시 알림 · 앱 배지" 참고.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase pg_cron이 1분마다 /api/push/dispatch를 부를 때 쓰는 비밀값(Supabase Vault에도 같은 값). 다른 비밀값과 다르게.
PUSH_DISPATCH_SECRET=change-me-to-a-third-long-random-string
# (선택) VAPID 연락처 — 비우면 앱 주소(https://…)를 쓴다. 예: mailto:you@example.com
VAPID_SUBJECT=
# (선택) Jev(TypeSafe AI)로 스크랩 항목의 PARA 카테고리를 자동 분류. console.typesafe.ai/settings/keys에서 발급.
# 비워두면 자동 분류 없이 지금처럼 보관함에만 저장됨.
TYPESAFE_API_KEY=

# 아래 두 값은 Project/Area/Resource별 노트/자료를 Google Drive 파일로 관리하는 기능
# (PLANNING.md 9번)에 필요. 서버 전용이라 브라우저로 노출되지 않음.
# README.md의 "Google Drive 연동 설정" 섹션을 먼저 따라 발급받아야 함.
# (refresh token은 환경변수가 아니라, 로그인 후 앱 사이드바의 "Google Drive 연결" 버튼으로
# 사용자별로 발급받아 DB(google_accounts 테이블)에 저장됨 — 여러 사용자를 지원하기 위함)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# drive.file 스코프라 앱이 만들지 않은 기존 Drive 파일은 Google Picker로 직접 골라야 보인다
# (자료 탭의 "Drive에서 가져오기"). Picker는 브라우저에서 바로 뜨는 위젯이라 이 값은
# NEXT_PUBLIC_ 접두사로 클라이언트에 노출되는 게 정상 — Google Cloud 콘솔에서 만든 API 키를
# HTTP 리퍼러(내 도메인)로 제한해서 씀. README.md의 "Google Drive 연동 설정" 참고.
NEXT_PUBLIC_GOOGLE_API_KEY=your-api-key
