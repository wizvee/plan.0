# Supabase project settings (Project Settings > API Keys in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# 아래 세 값은 /api/clip(공유하기 → 애플 단축어 스크랩) 기능에만 필요.
# 서버 전용이라 NEXT_PUBLIC_ 접두사가 없고, 절대 브라우저로 노출되지 않음.
# secret 키(Project Settings > API Keys의 "secret" 항목, 예전 service_role)
SUPABASE_SECRET_KEY=sb_secret_your-key
# 단축어가 헤더에 담아 보낼, 직접 정한 임의의 긴 문자열
CLIP_API_SECRET=change-me-to-a-long-random-string
# Supabase Authentication > Users에서 본인 계정의 User UID
CLIP_USER_ID=00000000-0000-0000-0000-000000000000
# (선택) Jev(TypeSafe AI)로 스크랩 항목의 PARA 카테고리를 자동 분류. console.typesafe.ai/settings/keys에서 발급.
# 비워두면 자동 분류 없이 지금처럼 보관함에만 저장됨.
TYPESAFE_API_KEY=

# 아래 두 값은 Project/Area/Resource별 노트/자료를 Google Drive 파일로 관리하는 기능
# (PLANNING.md 9번)에 필요. 서버 전용이라 브라우저로 노출되지 않음.
# README.md의 "Google Drive 연동 설정" 섹션을 먼저 따라 발급받아야 함.
# (refresh token은 환경변수가 아니라, 로그인 후 앱 사이드바의 "Google Drive 연결" 버튼으로
# 사용자별로 발급받아 DB(google_accounts 테이블)에 저장됨 — 여러 사용자를 지원하기 위함)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
